# =============================================================
# VECTORNET QA/QC PROJECT — .gitignore
# =============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
venv/
.venv/

# --- Environment (TUYET DOI KHONG PUSH KEY) ---
.env
*.env

# =============================================================
# DATA — Khong push du lieu len GitHub
# Luu tru tren Google Drive / NAS / S3 rieng
# =============================================================

# Raw images (dung luong lon)
data/raw/
!data/raw/README.md

# Ground Truth (BAO MAT - khong public)
data/ground_truth/*.json
!data/ground_truth/README.md
!data/ground_truth/gt_sample_001.json

# Bai nop cua labeler (du lieu ca nhan)
data/user_submissions/*/
!data/user_submissions/README.md
!data/user_submissions/labeler_A/submission_scene_001.json

# Bao cao QA tu dong sinh ra
data/qa_reports/*.json
!data/qa_reports/README.md

# =============================================================
# WAYMO DATASET — File nang
# =============================================================
waymo_mini_dataset/
*.tfrecord
*.tfrecord-*

# =============================================================
# FRONTEND
# =============================================================
frontend/.git/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/public/frontend_data.json

# =============================================================
# OS & EDITORS
# =============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
